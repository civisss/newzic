{
  "name": "newzic-app",
  "version": "0.0.1",
  "description": "Newzic mobile app - wraps newzic-fe via Capacitor",
  "scripts": {
    "build:fe": "cd ../newzic-fe && ng build --configuration=production && rm -rf ../newzic-app/www && cp -r dist/newzic/browser ../newzic-app/www",
    "sync": "npm run build:fe && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "typescript": "^6.0.3"
  }
}
